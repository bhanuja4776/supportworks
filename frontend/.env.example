# Firebase. From the Firebase console: Project settings -> General ->
# Your apps -> (your web app) -> SDK setup and configuration -> "Config"
# radio button.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Set to 1 to point every Firebase service at the local Local Emulator
# Suite (see firebase.json) instead of a real project — for local dev.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=0
